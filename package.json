{
  "name": "trams-microservices",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Microservices assignment: API Gateway + User Service + Notification Service over NATS/JetStream",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "concurrently -n gateway,user,notification -c blue,green,magenta \"npm:dev:gateway\" \"npm:dev:user\" \"npm:dev:notification\"",
    "dev:gateway": "npm run dev -w apps/api-gateway",
    "dev:user": "npm run dev -w apps/user-service",
    "dev:notification": "npm run dev -w apps/notification-service",
    "prisma:generate": "prisma generate && npm run prisma:generate -w apps/notification-service",
    "prisma:migrate:deploy": "prisma migrate deploy && npm run prisma:migrate:deploy -w apps/notification-service",
    "build": "tsc -b libs/contracts libs/messaging apps/api-gateway apps/user-service apps/notification-service",
    "clean": "npm run clean --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint \"{apps,libs}/**/*.ts\"",
    "format": "prettier --write \"{apps,libs}/**/*.ts\""
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "prisma": "^7.9.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@prisma/client": "^7.9.1"
  }
}
