{
  "name": "@app/notification-service",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Consumes user domain events from JetStream. Reachable only over NATS - no HTTP port.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@app/contracts": "*",
    "@app/messaging": "*",
    "dotenv": "^16.4.5",
    "nats": "^2.29.0",
    "pg": "^8.16.3",
    "pino": "^9.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6"
  }
}
