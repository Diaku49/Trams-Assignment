generator client {
  provider     = "prisma-client"
  output       = "../apps/user-service/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

// Events are committed here in the same transaction as domain writes. A
// background relay publishes them to JetStream and marks them as delivered.
model OutboxEvent {
  id            String    @id @db.Uuid
  subject       String
  payload       Json
  createdAt     DateTime  @default(now())
  nextAttemptAt DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)
  lockedAt      DateTime?
  lockedBy      String?
  lastError     String?

  @@index([publishedAt, nextAttemptAt])
  @@index([lockedAt])
  @@map("outbox_events")
}
