# ---------- Database ----------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trams?schema=public"
# Notification Service owns this separate database; it never reads or writes
# User Service tables.
NOTIFICATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trams_notifications?schema=public"

# ---------- NATS ----------
NATS_URL=tls://localhost:4222
# Set these two values per application to that application's matching broker
# credential pair below.
NATS_USER=
NATS_PASSWORD=
# Clients trust the CA that signed the NATS server certificate. Generate the
# local development files first with: ./infra/nats/generate-local-certs.sh
NATS_TLS_CA_FILE=./infra/nats/certs/ca.pem
# Broker-only paths. Set these in the NATS server environment (or mount secret
# files at these paths in deployment); applications do not read them.
NATS_TLS_CERT_FILE=./infra/nats/certs/nats-server.pem
NATS_TLS_KEY_FILE=./infra/nats/certs/nats-server-key.pem
# Credentials read by infra/nats/nats-server.conf when starting the broker.
GATEWAY_NATS_USER=
GATEWAY_NATS_PASSWORD=
USER_SERVICE_NATS_USER=
USER_SERVICE_NATS_PASSWORD=
NOTIFICATION_SERVICE_NATS_USER=
NOTIFICATION_SERVICE_NATS_PASSWORD=
NATS_STREAM_NAME=

# ---------- API Gateway ----------
GATEWAY_PORT=

# ---------- User Service ----------
JWT_SECRET=
JWT_EXPIRES_IN=
USER_SERVICE_QUEUE_GROUP=
PASSWORD_SALT_ROUNDS=
OUTBOX_PUBLISHED_RETENTION_MS=
OUTBOX_CLEANUP_INTERVAL_MS=
OUTBOX_CLEANUP_BATCH_SIZE=
OUTBOX_CLEANUP_MAX_BATCHES=
OUTBOX_METRICS_INTERVAL_MS=

# ---------- Notification Service ----------
NOTIFICATION_HEALTH_PORT=
NOTIFICATION_DURABLE_NAME=
NOTIFICATION_MAX_DELIVER=
NOTIFICATION_ACK_WAIT_MS=
NOTIFICATION_MAX_ACK_PENDING=
NOTIFICATION_DELIVERY_LEASE_MS=

# ---------- Shared ----------
NODE_ENV=
LOG_LEVEL=
